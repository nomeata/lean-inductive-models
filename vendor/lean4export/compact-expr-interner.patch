+/-- Expression-specialized `getIdx` backed by the compact exact interner. -/
+@[inline]
+def getExprIdx (x : Expr) (rec : M Json) : M Nat := do
+  if let some idx := (← get).visitedExprs.find? x then
+    return idx
+  let s ← rec
+  -- Dependencies emitted by `rec` may have inserted `x` themselves only if
+  -- the input expression is cyclic, which kernel expressions cannot be.
